{
  "app-id": "com.h.sirb",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "25.08",
  "command": "sirb",
  "finish-args": ["--share=network", "--share=ipc", "--socket=x11", "--socket=pulseaudio", "--device=dri", "--filesystem=xdg-download", "--talk-name=org.freedesktop.Flatpak"],
  "modules": [{
    "name": "sirb",
    "buildsystem": "simple",
    "build-commands": [
      "mkdir -p /app/lib/com.h.sirb /app/bin",
      "cp -a bundle/. /app/lib/com.h.sirb/",
      "install -m755 sirb-launcher /app/lib/com.h.sirb/launcher",
      "ln -s /app/lib/com.h.sirb/launcher /app/bin/sirb",
      "install -Dm644 com.h.sirb.desktop /app/share/applications/com.h.sirb.desktop",
      "install -Dm644 com.h.sirb.metainfo.xml /app/share/metainfo/com.h.sirb.metainfo.xml",
      "install -Dm644 LICENSE /app/share/licenses/com.h.sirb/LICENSE",
      "install -Dm644 icon128.png /app/share/icons/hicolor/128x128/apps/com.h.sirb.png",
      "install -Dm644 icon64.png /app/share/icons/hicolor/64x64/apps/com.h.sirb.png"
    ],
    "sources": [
      {"type":"dir", "path":"../build/flatpak-bundle", "dest":"bundle"},
      {"type":"file", "path":"../LICENSE"},
      {"type":"file", "path":"../packaging/sirb-launcher"},
      {"type":"file", "path":"com.h.sirb.desktop"},
      {"type":"file", "path":"com.h.sirb.metainfo.xml"},
      {"type":"file", "path":"../assets/icon/icon128.png"},
      {"type":"file", "path":"../assets/icon/icon64.png"}
    ]
  }]
}
