# Validate the pinned Standard Distribution without executing its CMake code.
# A version stamp alone does not prove an interrupted/pruned cache is usable.
function(cef_validate_distribution root system valid reason)
  set(required
    CMakeLists.txt LICENSE.txt
    cmake/FindCEF.cmake cmake/cef_variables.cmake cmake/cef_macros.cmake
    include/cef_app.h include/cef_version.h
    libcef_dll/CMakeLists.txt libcef_dll/base/cef_atomic_flag.cc)
  if(system STREQUAL "Linux")
    set(platform LINUX)
    set(binaries chrome-sandbox libcef.so libEGL.so libGLESv2.so
      libvk_swiftshader.so libvulkan.so.1 v8_context_snapshot.bin vk_swiftshader_icd.json)
  elseif(system STREQUAL "Windows")
    set(platform WINDOWS)
    set(binaries libcef.lib libcef.dll chrome_elf.dll d3dcompiler_47.dll
      libEGL.dll libGLESv2.dll v8_context_snapshot.bin vk_swiftshader.dll
      vk_swiftshader_icd.json vulkan-1.dll)
  elseif(system STREQUAL "Darwin")
    set(platform MAC)
    set(binaries "Chromium Embedded Framework.framework/Chromium Embedded Framework")
  else()
    message(FATAL_ERROR "Unsupported CEF platform: ${system}")
  endif()
  foreach(binary IN LISTS binaries)
    list(APPEND required "Release/${binary}")
    if(NOT system STREQUAL "Darwin")
      list(APPEND required "Debug/${binary}")
    endif()
  endforeach()
  if(NOT system STREQUAL "Darwin")
    list(APPEND required Resources/chrome_100_percent.pak Resources/chrome_200_percent.pak
      Resources/resources.pak Resources/icudtl.dat Resources/locales/en-US.pak)
  endif()

  # CEF's generated source lists contain the full wrapper/header inventory,
  # including nested cpptoc/ctocpp/views and test directories. Check only the
  # common lists and this platform's lists; no duplicated source inventory.
  if(EXISTS "${root}/libcef_dll/CMakeLists.txt")
    file(STRINGS "${root}/libcef_dll/CMakeLists.txt" lines)
    set(active FALSE)
    set(source_count 0)
    foreach(line IN LISTS lines)
      string(STRIP "${line}" line)
      if(line MATCHES "^set\\(LIBCEF_[A-Z_]*SRCS(_(LINUX|WINDOWS|MAC))?$")
        set(active TRUE)
        if(CMAKE_MATCH_2 AND NOT CMAKE_MATCH_2 STREQUAL platform)
          set(active FALSE)
        endif()
      elseif(line STREQUAL ")")
        set(active FALSE)
      elseif(active AND line MATCHES "^[A-Za-z0-9_./-]+\\.(cc|h|mm|inc)$")
        list(APPEND required "libcef_dll/${line}")
        math(EXPR source_count "${source_count}+1")
      endif()
    endforeach()
    if(source_count EQUAL 0)
      set(${valid} FALSE PARENT_SCOPE)
      set(${reason} "unreadable wrapper source inventory" PARENT_SCOPE)
      return()
    endif()
  endif()
  list(REMOVE_DUPLICATES required)
  foreach(relative IN LISTS required)
    if(NOT EXISTS "${root}/${relative}" OR IS_DIRECTORY "${root}/${relative}")
      set(${valid} FALSE PARENT_SCOPE)
      set(${reason} "missing ${relative}" PARENT_SCOPE)
      return()
    endif()
    # LIMIT works with CMake 3.10; do not read multi-GB runtime libraries.
    file(READ "${root}/${relative}" first_byte LIMIT 1 HEX)
    if(first_byte STREQUAL "")
      set(${valid} FALSE PARENT_SCOPE)
      set(${reason} "empty ${relative}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${valid} TRUE PARENT_SCOPE)
  set(${reason} "complete" PARENT_SCOPE)
endfunction()

# A codec-enabled build must be built from this exact CEF revision, not a
# random libcef/libffmpeg replacement with a different API/Chromium ABI.
function(cef_validate_version root expected valid reason)
  set(actual "")
  if(EXISTS "${root}/include/cef_version.h")
    file(STRINGS "${root}/include/cef_version.h" definitions REGEX "^#define CEF_VERSION ")
    foreach(definition IN LISTS definitions)
      if(definition MATCHES "^#define CEF_VERSION \"([^\"]+)\"")
        set(actual "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endif()
  if(NOT actual STREQUAL expected)
    set(${valid} FALSE PARENT_SCOPE)
    set(${reason} "CEF version mismatch: expected ${expected}, got '${actual}'" PARENT_SCOPE)
  else()
    set(${valid} TRUE PARENT_SCOPE)
    set(${reason} "matching CEF version" PARENT_SCOPE)
  endif()
endfunction()

# Also usable independently for diagnostics and extraction checks.
if(DEFINED CEF_VALIDATE_ROOT)
  if(NOT DEFINED CEF_VALIDATE_SYSTEM)
    set(CEF_VALIDATE_SYSTEM "${CMAKE_HOST_SYSTEM_NAME}")
  endif()
  cef_validate_distribution("${CEF_VALIDATE_ROOT}" "${CEF_VALIDATE_SYSTEM}" valid reason)
  if(NOT valid)
    message(FATAL_ERROR "Incomplete CEF distribution at ${CEF_VALIDATE_ROOT}: ${reason}")
  endif()
  message(STATUS "CEF distribution is complete: ${CEF_VALIDATE_ROOT}")
endif()
